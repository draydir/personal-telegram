# @BotFather — dedicated personal bot (not Jarvis dispatch / HR bots)
TELEGRAM_BOT_TOKEN=

# Where outbound /api/notify messages go (use /id in Telegram after webhook is live)
TELEGRAM_DEFAULT_CHAT_ID=

# Comma-separated Telegram user ids allowed to use bot commands (empty = allow all)
TELEGRAM_ALLOWED_USER_IDS=

# Optional: Telegram sends X-Telegram-Bot-Api-Secret-Token header; must match setWebhook secret_token
TELEGRAM_WEBHOOK_SECRET=

# Bearer token for POST /api/notify from heys3xy, provision-admin, cron, etc.
NOTIFY_API_SECRET=
